<section class="tab _combate0" data-group="primary" data-tab="combate">

    <nav class="tabs _subMenu" data-group="combate">
        <a data-action="tab" data-group="combate" data-tab="principal">{{localize 'common.combate'}}</a>
        <a data-action="tab" data-group="combate" data-tab="acciones">{{localize 'common.acciones'}}</a>
    </nav>

    <section class="tab _combate scrollable scrollableCombate1 _subTab" 
             data-group="combate" 
             data-tab="principal">

        <div class="_left">
            {{>combate_mods_comun}}
            {{>combate_armas_comun}}
            {{>combate_armaduras_comun}}s
        </div>
        <div class="_right">
            {{#if (eq myRules 'aq3')}} 
                {{>combat_location_aq3}}
            {{/if}}
            {{#if (eq myRules 'aq4')}} 
                {{>combat_location_aq4}}
            {{/if}}
            {{#if (eq myRules 'vyc')}} 
                {{>combat_location_vyc}}
            {{/if}}
        </div>

    </section>

    <section class="tab _acciones scrollable scrollableCombate2 _subTab" 
                data-group="combate" 
                data-tab="acciones">
        {{>combateAcciones_comun}}
    </section>

</section>