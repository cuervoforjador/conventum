    </div>

</div>

<h4 class="_title divider" style="margin-top: 10px;">{{localize 'common.tecSociales'}}</h4>
<div class="_modSociales">
    <table class="_list">
        <tbody>
        {{#each sociales.tecnicas as |tecnica index|}}
            <tr class="_item">
                <td style="width: 100%">
                    <a class="_name"
                        data-action="{{#if ../isEditable}}_showItem{{else}}_showDescr{{/if}}" 
                        data-id="{{tecnica.item.id}}">
                        <label class="_name _lSize">{{tecnica.item.name}}</label>
                    </a>                        
                </td>
                <td>
                {{#if ../isEditable}}
                    <a data-action="_navToItem"  data-id="{{tecnica.item.id}}" data-name="">
                        <label class="_xsSize _center2 _pointer">{{_valueMod tecnica.value}} %</label>
                    </a>
                {{else}}
                    <label class="_xsSize _center2">{{_valueMod tecnica.value}} %</label>                   
                {{/if}} 
                </td> 
                {{#if ../isEditable}}
                <td>
                    <button type="button"
                            class="icon fas fa-remove" 
                            data-action="_deleteItem" 
                            data-id="{{item.id}}"
                            data-tooltip="{{localize 'tooltip.borrarItem'}}">
                    </button>                 
                </td>
                {{else}}
                <td>
                    <button type="button" 
                            data-action="_roll"
                            data-item="{{tecnica.item.id}}"
                            data-target="tecnica"
                            data-value="{{tecnica.value}}"
                            data-tooltip="{{{localize 'explain.rollTecnica'}}}">
                        <i class="fa-regular fa-dice-d10"></i>
                    </button>
                </td>
                {{/if}}                                       
            </tr>
        {{/each}}
        </tbody>
    </table>
</div>