<h4 class="_title divider">{{localize 'common.modSociales'}}</h4>
<div class="_modSociales">

    <div class="_box _table _chars" style="padding-top: 10px">

    <!-- APARIENCIA -->
        <div class="_row _char _100 _right">
            <label class="_charTitle _bothPadded" style="text-align: right;">{{localize 'CHAR.asp'}} {{sociales.apariencia.label}}</label>
        </div>    
        <div class="_row _char _100">
            <label class="_charTitle">{{localize 'common.apariencia'}}</label>

            {{#if isEditable}}
            <input type="number" 
                    {{{_disabled}}}
                    name="system.sociedad.apariencia.value" 
                    value="{{system.sociedad.apariencia.value}}" 
                    min="-150" 
                    max="150"
                    class="_charValue">  
            {{else}}        
            <label class="_input _charValue">
                    <span class="_value _center">{{system.sociedad.apariencia.value}}</span>
            </label>        
            {{/if}}

            <label class="_input _charValue _mod">
                    <span class="_value _center">{{_valueMod sociales.apariencia.mod}}</span>
            </label>
            <label class="_inter">=</label>
            <label class="_input _charValue _total">
                    <span class="_value _center">{{_valueMod sociales.apariencia.total}}</span>
            </label>

        </div>
        <table class="_list">
            <tbody>
            {{#each sociales.apariencia.items as |item index|}}
                <tr class="_item">
                    <td style="width: 100%">
                        <a class="_name"
                           data-action="{{#if ../isEditable}}_showItem{{else}}_showDescr{{/if}}" 
                           data-id="{{item.id}}">
                            <label class="_name _lSize">{{item.name}}</label>
                        </a>                        
                    </td>
                    <td>
                    {{#if ../isEditable}}
                        <a data-action="_navToItem"  data-id="{{item.id}}" data-name="system.sociedad.apariencia">
                            <label class="_xsSize _center2 _pointer">{{_valueMod item.system.sociedad.apariencia}}</label>
                        </a>
                    {{else}}
                        <label class="_xsSize _center2">{{_valueMod item.system.sociedad.apariencia}}</label>                   
                    {{/if}} 
                    </td> 
                    {{#if ../isEditable}}
                    <td>
                        <button type="button"
                                class="icon fas fa-remove" 
                                data-action="_deleteItem" 
                                data-id="{{item.id}}"
                                data-tooltip="{{localize 'tooltip.borrarItem'}}">
                        </button>                 
                    </td>
                    {{/if}}                                       
                </tr>
            {{/each}}
            </tbody>
        </table>         

