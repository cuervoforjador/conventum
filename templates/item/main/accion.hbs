<div class="_main {{#if isEditable}}_editable{{/if}}">
    <div class="_sheetContent">

        {{!-- PROPERTIES --}}
        <div class="_properties">
            {{formInput 
                systemFields.descripcion 
                class="_italic _resumen"
                enriched=_textResumen
                value=system.resumen 
                name="system.resumen"
                toggled=true}}                                
            <div class="_buttons _spaced _row">
                <div class="_combo _gapped">
                    <div class="_alternative _combo _smallGapped _smallPadding _boxed">
                        {{{checkButton 'system.favorita' 'common.favorita' 'fa-star'}}}                    
                    </div>                
                    <div class="_alternative _combo _smallGapped _smallPadding _boxed">
                        {{{checkButton 'system.ataque' 'common.ataque' 'fa-sword'}}}
                        {{{checkButton 'system.defensa' 'common.defensa' 'fa-shield'}}}
                        {{{checkButton 'system.movimiento' 'common.movimiento' 'fa-arrow-right'}}}
                    </div>
                    {{#if configRULES.talentos.esgrima}}
                    <div class="_combo _smallGapped _smallPadding _boxed">
                        {{{checkButton 'system.treta.treta' 'common.treta' 'fa-swords'}}}
                    </div>
                    {{/if}}
                </div>                
                <div class="_alternative _combo _smallGapped _smallPadding _boxed">
                    {{{checkButton 'system.normal' 'common.normal0' 'fa-1'}}}
                    {{{checkButton 'system.extendida' 'common.extendida' 'fa-2'}}}                    
                </div>            
            </div>

            {{#if system.treta.treta}}
            <div class="_buttons _spaced _row">
                <div class="_combo _smallGapped">
                    {{{checkButton 'system.treta.verdadera' 'common.tretaVerdadera' 'fa-sparkles'}}}
                    {{{checkButton 'system.treta.vulgar' 'common.tretaVulgar' 'fa-smog'}}} 
                </div>
                <div class="_combo _gapped">
                    <div class="_combo _smallGapped">
                        <label>{{localize 'ATTR.ptaShort'}}:</label>
                        <input type="number" 
                            {{{_disabled}}}
                            class="_xsSize"
                            name="system.treta.ptAp" 
                            value="{{system.treta.ptAp}}">
                    </div>                            
                    <div class="_combo _smallGapped">
                        <label>{{localize 'common.esgrima'}}:</label>
                        <input type="number" 
                            {{{_disabled}}}
                            class="_xsSize"
                            name="system.treta.requisitos.esgrima" 
                            value="{{system.treta.requisitos.esgrima}}" 
                            data-tooltip="{{localize 'tooltip.requisitosEsgrima'}}">
                    </div>
                    <div class="_combo _smallGapped">
                        {{{checkButton 'system.treta.requisitos.skill' 'common.competencia' 'fa-gear'}}}
                        {{#if system.treta.requisitos.skill}}
                            <select name="system.treta.requisitos.skillID" {{{_disabled}}}>
                            {{selectOptions competenciasArmas 
                                            selected=system.treta.requisitos.skillID
                                            localize=false
                                            nameAttr="key"
                                            labelAttr="label" }}
                            </select>                                
                            <input type="number" 
                                {{{_disabled}}}
                                class="_xsSize"
                                name="system.treta.requisitos.skillValue" 
                                value="{{system.treta.requisitos.skillValue}}">
                        {{/if}}
                    </div>                    
                </div>
            </div>                           
            {{/if}} 
                       
            <div class="_options _combo">
                {{#each competenciasArmas as |competencia index|}}
                <img class="_option {{#if (_property 'system.armas' competencia.key 'checked')}} _selected {{/if}}"
                     src="{{competencia.img}}" 
                     data-path="system.armas"
                     data-key="{{competencia.key}}"
                     data-tooltip="{{competencia.label}}" />
                {{/each}}
            </div>
            <div class="_row _gapped _menu">
                {{{navTab 'primary' (array 'propiedades' 'descripcion') '_expanded'}}}
            </div>                                     
        </div>

        {{>tab_AccionesPropiedades}}
        {{>tab_Descripcion}}

    </div>
    <div class="_sheetFooter">
        {{>item_footer}}
    </div>    
</div>