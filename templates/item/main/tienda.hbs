<div class="_main {{#if isEditable}}_editable{{/if}}">
    <div class="_sheetContent">

        {{!-- PROPERTIES --}}
        <div class="_properties">                       

            <div class="_row _middle _gapped">
                <label>{{localize 'common.carpeta'}}:</label>
                <select name="system.folder" style="width: auto">
                    {{selectOptions _folders 
                                    localize=false
                                    selected=system.folder
                                    nameAttr="key"
                                    labelAttr="label" }}
                </select>   
                <button type="button" data-action="_refresh"
                        data-tooltip="{{{localize 'explain.refreshSheets'}}}">
                    {{localize 'common.actualizarFichas'}}
                </button>
            </div>

            <div class="_row _gapped _menu">
                {{{navTab 'primary' (array 'actors' 'productos' 'descripcion') '_expanded'}}}
            </div>

        </div>
        
        {{>tab_Actores}}
        {{>tab_Productos}}
        {{>tab_Descripcion}}
    </div>
    <div class="_sheetFooter">
        {{>item_footer}}
    </div>    
</div>